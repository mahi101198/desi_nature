# Copy to .env.local for local development. Never commit real values.
# Variables starting with NEXT_PUBLIC_ are visible in the browser: never put secrets in them.

# ---- Site (public) ----
# Canonical origin. Keep the production domain even on preview deployments.
NEXT_PUBLIC_SITE_URL=https://desinature.in
# WhatsApp number with country code, digits only (e.g. 91XXXXXXXXXX). Empty hides WhatsApp links.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Public enquiry email. Empty hides it.
NEXT_PUBLIC_CONTACT_EMAIL=
# Social profile URLs (https://...). Empty ones are hidden.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ---- Search engines and analytics (public) ----
# Google Search Console HTML-tag verification code (the content="..." value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools msvalidate.01 code.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# GA4 measurement ID (G-XXXXXXX). Optional; loads only after visitor consent, production only.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Enquiry delivery (server only, secret) ----
# HTTPS endpoint that receives enquiry JSON (e.g. a Google Apps Script web app that appends to a Sheet).
ENQUIRY_WEBHOOK_URL=
# Optional shared secret (16+ chars); requests carry an HMAC-SHA256 x-desinature-signature header.
ENQUIRY_WEBHOOK_SECRET=

# ---- Preview deployments ----
# "true" shows articles in review/approved state on preview deployments only (never production).
CONTENT_PREVIEW=

# ---- Content pipeline (GitHub Actions or local; never on Vercel) ----
# manual (default, free) | anthropic (paid API) | ollama (local model)
AI_PROVIDER=manual
# review (Mode A, default) | autonomous (Mode B)
PUBLISH_MODE=review
# Claude API key from console.anthropic.com. Billed per use; NOT included in a Claude/Claude Code subscription.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5).
ANTHROPIC_MODEL=
# "true" lets the model search the web for sources (billed per search).
ANTHROPIC_WEB_SEARCH=
# Local model via Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
